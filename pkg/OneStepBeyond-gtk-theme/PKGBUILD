# Maintainer: budRich af budlabs
# Contributor: budRich af budlabs

pkgname=OneStepBeyond-gtk-theme
_pkgname=${pkgname%%-*}
pkgver=2026.01.05.4
pkgrel=1
pkgdesc='Theme for GTK2, GTK3 and GTK4 based on "OneSteBack"'
arch=('any')
url='https://github.com/budRich/OneStepBeyond'
license=('GPL')
depends=()
makedepends=('sassc')
optdepends=()
source=("$url/archive/$pkgver/${_pkgname}-$pkgver.tar.gz")
sha256sums=('e24dacc4c5818ca05fb0d63b49a715675215f05b592a96beaf9298976eb83aa7')

# https://github.com/budRich/OneStepBeyond/archive/refs/tags/2026.01.05.tar.gz

# sha256sums=('SKIP')
# url='file:///home/bud/git/lab/typiskt'
# source=("${pkgname}-${pkgver}::git+$url")

build() {
  cd "$_pkgname-$pkgver"
  make DESTDIR="$pkgdir/" PREFIX=/usr
}

package() {
  cd "$_pkgname-$pkgver"

  make DESTDIR="$pkgdir/" PREFIX=/usr install

  install -Dm644 -t "$pkgdir/usr/share/doc/$_pkgname" README.md
}
