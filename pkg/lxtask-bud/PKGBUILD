pkgname=lxtask-bud
_pkgname=${pkgname%-bud}
pkgver=0.1.12
pkgrel=1
pkgdesc='Task manager of the LXDE Desktop (budRich fork)'
arch=(x86_64)
url='https://github.com/lxde/lxtask'
license=(GPL-2.0-or-later)
groups=(lxde)
depends=(
  glib2
  glibc
  gtk2
)
makedepends=(
  intltool
)
conflicts=(lxtask)
provides=(lxtask)
source=(
  "https://github.com/budRich/lxtask/archive/refs/tags/${pkgver}.tar.gz"
  lxtask.appdata.xml
  lxtask-transient-dialog.patch
)
b2sums=('c460820be46782fee036239279993b842120d3f21663d9c39ea9158a2d2bc67b7af5cfb9feb20fae4fc1f6fdd5ffbbd234574739cee059dc3e6fb8acaff09007'
        'd52df1095650dd326fe794d0c08461c1b4c9c3bf2a31ea7f737596423011d90d12d7f613882a401534d07ed29af02578ae8583813cf7da0b1bc94f8ad45c3879'
        '7e61be192df34fb12b3117e2e99562c472e2cdf0e594b4db9bc4dcf3703eacd5740353c4fc8e62943b75097c227bc527b390eed25376e14071fdc3e2aa476225')

prepare() {
  cd lxtask-"${pkgver}"

  autoreconf -fi
}

build() {
  cd lxtask-"${pkgver}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
  make
}

package() {
  cd lxtask-"${pkgver}"
  make DESTDIR="$pkgdir" install
  install -Dm644 ../$_pkgname.appdata.xml "$pkgdir/usr/share/metainfo/$_pkgname.appdata.xml"
}
